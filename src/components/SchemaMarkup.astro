---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const currentUrl = Astro.url.href;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["SportsActivityLocation", "LocalBusiness"],
      "@id": "https://energy-factory-longkhanh.com/#organization",
      "name": "The Energy Factory",
      "alternateName": "The Energy Factory - Hybrid Fitness Long Khanh",
      "url": currentUrl,
      "logo": {
        "@type": "ImageObject",
        "url": "/images/dumbbell-icon.png"
      },
      "image": [
        "/images/main-guy.png",
        "/images/fitness.png"
      ],
      "description": lang === 'vi' 
        ? "Huấn luyện hybrid fitness chuyên nghiệp kết hợp calisthenics và tập tạ tại Long Khánh. Bao gồm huấn luyện cá nhân, kế hoạch dinh dưỡng và thực phẩm bổ sung cao cấp."
        : "Professional hybrid fitness coaching combining calisthenics and weight training in Long Khanh. Includes personal training, nutrition coaching, and premium supplements.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Long Khanh City",
        "addressRegion": "Dong Nai Province",
        "addressCountry": "VN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "10.9456",
        "longitude": "107.2426"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "06:00",
          "closes": "21:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "07:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Sunday",
          "opens": "08:00",
          "closes": "18:00"
        }
      ],
      "priceRange": "$$",
      "areaServed": {
        "@type": "City",
        "name": "Long Khanh City"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": lang === 'vi' ? "Dịch Vụ & Sản Phẩm" : "Services & Products",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": lang === 'vi' ? "Làm Chủ Calisthenics" : "Calisthenics Mastery",
              "description": lang === 'vi' 
                ? "Làm chủ các động tác với trọng lượng cơ thể - xà đơn, xà kép, planche và hơn thế nữa"
                : "Master bodyweight movements - pull-ups, dips, planches, and advanced skills",
              "provider": {
                "@id": "https://energy-factory-longkhanh.com/#organization"
              },
              "serviceType": "Fitness Training",
              "category": "Calisthenics Training"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": lang === 'vi' ? "Tập Tạ" : "Weight Training",
              "description": lang === 'vi'
                ? "Tập sức mạnh tiến bộ với tạ đòn, tạ đơn và máy tập"
                : "Progressive strength training with barbells, dumbbells, and machines",
              "provider": {
                "@id": "https://energy-factory-longkhanh.com/#organization"
              },
              "serviceType": "Fitness Training",
              "category": "Weight Training"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": lang === 'vi' ? "Huấn Luyện Hybrid" : "Hybrid Training Coaching",
              "description": lang === 'vi'
                ? "Chương trình cá nhân hóa kết hợp calisthenics và tạ với kế hoạch dinh dưỡng"
                : "Personalized programs combining calisthenics and weights with nutrition coaching",
              "provider": {
                "@id": "https://energy-factory-longkhanh.com/#organization"
              },
              "serviceType": "Personal Training",
              "category": "Hybrid Fitness"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Product",
              "name": lang === 'vi' ? "Thực Phẩm Bổ Sung" : "Premium Supplements",
              "description": lang === 'vi'
                ? "Protein, pre-workout, BCAA và các sản phẩm phục hồi cao cấp"
                : "Protein powders, pre-workouts, BCAAs, and recovery supplements",
              "category": "Sports Nutrition"
            }
          }
        ]
      },
      "knowsAbout": [
        "Calisthenics",
        "Weight Training",
        "Powerlifting",
        "Bodyweight Training",
        "Nutrition Coaching",
        "Sports Supplements",
        "Hybrid Fitness",
        "Pull-ups",
        "Planches",
        "Muscle Building",
        "Strength Training"
      ],
      "slogan": lang === 'vi' 
        ? "Xây dựng sức mạnh. Làm chủ chuyển động. Sống mạnh mẽ."
        : "Build strength. Master movement. Live powerfully.",
      "audience": {
        "@type": "Audience",
        "audienceType": "Fitness Enthusiasts",
        "suggestedMinAge": 18,
        "suggestedMaxAge": 45
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://energy-factory-longkhanh.com/#website",
      "url": currentUrl,
      "name": "The Energy Factory",
      "description": lang === 'vi'
        ? "Website chính thức của The Energy Factory - Huấn luyện hybrid fitness tại Long Khánh"
        : "Official website of The Energy Factory - Hybrid fitness coaching in Long Khanh",
      "publisher": {
        "@id": "https://energy-factory-longkhanh.com/#organization"
      },
      "inLanguage": [lang, lang === 'en' ? 'vi' : 'en']
    }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
