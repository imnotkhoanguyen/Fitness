---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-section">
        <h3>{t('site.title')}</h3>
        <p>{t('footer.tagline')}</p>
      </div>
      <div class="footer-section">
        <h4>{t('nav.services')}</h4>
        <a href={lang === 'en' ? '/services' : '/vi/services'}>{t('services.nutrition.title')}</a>
        <a href={lang === 'en' ? '/services' : '/vi/services'}>{t('services.fitness.title')}</a>
        <a href={lang === 'en' ? '/services' : '/vi/services'}>{t('services.lifestyle.title')}</a>
      </div>
      <div class="footer-section">
        <h4>{t('nav.contact')}</h4>
        <p>{t('location.address')}</p>
      </div>
      <div class="footer-section">
        <h4>{lang === 'en' ? 'Quick Links' : 'Liên Kết'}</h4>
        <a href={lang === 'en' ? '/faq' : '/vi/faq'}>FAQ</a>
        <a href={lang === 'en' ? '/booking' : '/vi/booking'}>{lang === 'en' ? 'Book a Session' : 'Đặt Lịch'}</a>
        <a href={lang === 'en' ? '/privacy' : '/privacy'}>{lang === 'en' ? 'Privacy Policy' : 'Chính Sách Bảo Mật'}</a>
        <a href={lang === 'en' ? '/terms' : '/terms'}>{lang === 'en' ? 'Terms of Service' : 'Điều Khoản Dịch Vụ'}</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {currentYear} {t('site.title')}. {t('footer.rights')}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 3rem 0 1rem;
    margin-top: auto;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer-section h3 {
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
  }

  .footer-section h4 {
    margin-bottom: 1rem;
    font-size: 1.2rem;
  }

  .footer-section p {
    opacity: 0.9;
    line-height: 1.6;
  }

  .footer-section a {
    display: block;
    color: white;
    text-decoration: none;
    margin-bottom: 0.5rem;
    opacity: 0.9;
    transition: opacity 0.3s;
  }

  .footer-section a:hover {
    opacity: 1;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 1rem;
    text-align: center;
    opacity: 0.8;
  }
</style>
