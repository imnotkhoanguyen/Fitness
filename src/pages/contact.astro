---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('en');
---

<Layout title={`${t('nav.contact')} - ${t('site.title')}`}>
  <section class="hero">
    <div class="container">
      <h1>{t('contact.title')}</h1>
      <p>{t('contact.coaching.text')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="max-width: 900px; margin: 0 auto;">
        <div class="grid" style="grid-template-columns: 1fr; gap: 2rem;">
          <div class="card">
            <h3 style="margin-bottom: 1.5rem;">{t('contact.coaching')}</h3>
            <form style="display: flex; flex-direction: column; gap: 1.5rem;">
              <div>
                <label for="name" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">{t('contact.name')}</label>
                <input type="text" id="name" name="name" required style="width: 100%; padding: 0.75rem; border: 2px solid #e2e8f0; border-radius: 5px; font-size: 1rem;" />
              </div>
              <div>
                <label for="email" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">{t('contact.email')}</label>
                <input type="email" id="email" name="email" required style="width: 100%; padding: 0.75rem; border: 2px solid #e2e8f0; border-radius: 5px; font-size: 1rem;" />
              </div>
              <div>
                <label for="goal" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Fitness Goal</label>
                <select id="goal" name="goal" style="width: 100%; padding: 0.75rem; border: 2px solid #e2e8f0; border-radius: 5px; font-size: 1rem;">
                  <option value="">Select your goal...</option>
                  <option value="muscle">Build Muscle</option>
                  <option value="strength">Get Stronger</option>
                  <option value="calisthenics">Master Calisthenics</option>
                  <option value="weight">Lose Weight</option>
                  <option value="hybrid">Hybrid Training</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div>
                <label for="experience" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Training Experience</label>
                <select id="experience" name="experience" style="width: 100%; padding: 0.75rem; border: 2px solid #e2e8f0; border-radius: 5px; font-size: 1rem;">
                  <option value="">Select your level...</option>
                  <option value="beginner">Beginner (0-1 year)</option>
                  <option value="intermediate">Intermediate (1-3 years)</option>
                  <option value="advanced">Advanced (3+ years)</option>
                </select>
              </div>
              <div>
                <label for="message" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">{t('contact.message')}</label>
                <textarea id="message" name="message" rows="5" required style="width: 100%; padding: 0.75rem; border: 2px solid #e2e8f0; border-radius: 5px; font-size: 1rem; resize: vertical;" placeholder="Tell me about your current routine, challenges, and what you want to achieve..."></textarea>
              </div>
              <button type="submit" class="btn" style="align-self: flex-start; padding: 1rem 2.5rem;">{t('contact.submit')}</button>
            </form>
          </div>

          <div class="card">
            <h3 style="margin-bottom: 1rem;">Training Location & Hours</h3>
            <div style="color: #666; line-height: 2;">
              <p><strong>Location:</strong></p>
              <p>{t('location.address')}</p>
              <p style="margin-top: 1rem;"><strong>Session Hours:</strong></p>
              <p>Mon-Fri: 6:00 AM - 9:00 PM</p>
              <p>Sat: 7:00 AM - 8:00 PM</p>
              <p>Sun: 8:00 AM - 6:00 PM</p>
              <p style="margin-top: 1rem;"><strong>Services:</strong></p>
              <p>✅ 1-on-1 Coaching</p>
              <p>✅ Online Programs</p>
              <p>✅ Nutrition Coaching</p>
              <p>✅ Supplement Sales</p>
            </div>
          </div>

          <div class="card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <h3 style="margin-bottom: 1rem; color: white;">Quick Questions?</h3>
            <p style="margin-bottom: 1rem;">Want to know about pricing, programs, or supplement availability?</p>
            <p style="margin-bottom: 1rem;">Fill out the form above or send a quick message with your questions. I typically respond within 24 hours.</p>
            <p style="font-size: 0.9rem; opacity: 0.9;">💪 First consultation is always free</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
