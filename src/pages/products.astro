---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('en');
---

<Layout title={`${t('nav.products')} - ${t('site.title')}`}>
  <section class="hero">
    <div class="container">
      <h1>{t('products.title')}</h1>
      <p>Fuel your training with premium supplements for maximum performance and recovery</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        <div class="card product-card">
          <div class="product-badge best-seller">Best Seller</div>
          <h3>{t('products.protein.title')}</h3>
          <p>{t('products.protein.desc')}</p>
          <ul class="feature-list">
            <li>25g+ protein per serving</li>
            <li>Fast absorption</li>
            <li>Multiple flavors</li>
            <li>Whey & plant-based options</li>
          </ul>
          <button class="btn full-width">Contact to Order</button>
        </div>
        
        <div class="card product-card">
          <div class="product-badge energy">Energy Boost</div>
          <h3>{t('products.preworkout.title')}</h3>
          <p>{t('products.preworkout.desc')}</p>
          <ul class="feature-list">
            <li>Explosive energy</li>
            <li>Enhanced focus</li>
            <li>Pump activators</li>
            <li>No crash formula</li>
          </ul>
          <button class="btn full-width">Contact to Order</button>
        </div>

        <div class="card product-card">
          <div class="product-badge recovery">Recovery</div>
          <h3>{t('products.recovery.title')}</h3>
          <p>{t('products.recovery.desc')}</p>
          <ul class="feature-list">
            <li>BCAA 2:1:1 ratio</li>
            <li>L-Glutamine</li>
            <li>Reduce soreness</li>
            <li>Faster muscle repair</li>
          </ul>
          <button class="btn full-width">Contact to Order</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section dark-section center-content">
    <div class="container">
      <h2 class="section-title">Why Our Supplements?</h2>
      <div class="grid grid-3">
        <div>
          <h3 class="benefit-title">Quality Tested</h3>
          <p class="benefit-text">Every product is tested for purity and potency</p>
        </div>
        <div>
          <h3 class="benefit-title">Coaching Approved</h3>
          <p class="benefit-text">Personally selected for hybrid training results</p>
        </div>
        <div>
          <h3 class="benefit-title">Real Results</h3>
          <p class="benefit-text">Proven formulas backed by science and experience</p>
        </div>
      </div>
      <a href="/contact" class="btn cta-button">Ask About Products</a>
    </div>
  </section>
</Layout>

<style>
  .dark-section {
    background: #0a0a0a;
  }

  .center-content {
    text-align: center;
  }

  .product-card {
    position: relative;
    border-top: 4px solid #00FFFF;
  }

  .product-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: #00FFFF;
    color: #000000;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
    font-family: 'Montserrat', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .product-badge.energy {
    background: #FF0080;
  }

  .product-badge.recovery {
    background: #00FF88;
  }

  .feature-list {
    margin-top: 1rem;
    color: #cccccc;
    line-height: 2;
    list-style: none;
    padding-left: 0;
  }

  .feature-list li {
    padding-left: 1.5rem;
    position: relative;
  }

  .feature-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #00FFFF;
    font-weight: bold;
  }

  .full-width {
    margin-top: 1.5rem;
    width: 100%;
  }

  .benefit-title {
    color: #00FFFF;
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .benefit-text {
    color: #cccccc;
  }

  .cta-button {
    margin-top: 2rem;
  }
</style>
