---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('en');
---

<Layout title={`${t('nav.locations')} - ${t('site.title')}`}>
  <section class="hero">
    <div class="container">
      <h1>{t('location.title')}</h1>
      <p>{t('location.description')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="max-width: 800px; margin: 0 auto;">
        <div class="card">
          <h3 style="margin-bottom: 1rem;">Long Khanh Location</h3>
          <p style="margin-bottom: 1rem;"><strong>Address:</strong> {t('location.address')}</p>
          <p style="margin-bottom: 1rem; color: #666;">
            Our coaching center is conveniently located in the heart of Long Khanh City, 
            making it easily accessible for residents throughout Dong Nai Province.
          </p>
          <img src="/images/fitness.png" alt="Fitness Center" style="width: 100%; border-radius: 10px; margin-top: 1rem;" />
        </div>

        <div class="card" style="margin-top: 2rem;">
          <h3 style="margin-bottom: 1rem;">Operating Hours</h3>
          <table style="width: 100%; color: #666;">
            <tr style="border-bottom: 1px solid #eee;">
              <td style="padding: 0.75rem 0;">Monday - Friday</td>
              <td style="padding: 0.75rem 0; text-align: right;">6:00 AM - 9:00 PM</td>
            </tr>
            <tr style="border-bottom: 1px solid #eee;">
              <td style="padding: 0.75rem 0;">Saturday</td>
              <td style="padding: 0.75rem 0; text-align: right;">7:00 AM - 8:00 PM</td>
            </tr>
            <tr>
              <td style="padding: 0.75rem 0;">Sunday</td>
              <td style="padding: 0.75rem 0; text-align: right;">8:00 AM - 6:00 PM</td>
            </tr>
          </table>
        </div>

        <div class="card" style="margin-top: 2rem;">
          <h3 style="margin-bottom: 1rem;">Get Directions</h3>
          <p style="color: #666; margin-bottom: 1rem;">
            We serve clients throughout Long Khanh and surrounding areas in Dong Nai Province. 
            Contact us for specific directions to our location.
          </p>
          <a href="/contact" class="btn">{t('contact.title')}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
