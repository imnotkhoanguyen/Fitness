---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('en');
---

<Layout title={`Book a Session - ${t('site.title')}`}>
  <section class="hero" style="padding: 4rem 0 3rem;">
    <div class="container">
      <h1>Book Your Free Consultation</h1>
      <p style="font-size: 1.1rem; max-width: 700px; margin: 1rem auto 0;">
        Ready to start your hybrid fitness journey? Schedule your free 30-minute consultation to discuss your goals and find the perfect training program.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="max-width: 900px; margin: 0 auto;">
        <div class="grid" style="grid-template-columns: 1fr; gap: 2rem;">
          <div class="card">
            <h3 style="margin-bottom: 1rem;">What to Expect:</h3>
            <ul style="color: #666; line-height: 2.2; margin-bottom: 2rem;">
              <li>✅ <strong>Free 30-minute consultation</strong> - No commitment required</li>
              <li>✅ <strong>Fitness assessment</strong> - Discuss your current level and goals</li>
              <li>✅ <strong>Program overview</strong> - Learn how hybrid training works for you</li>
              <li>✅ <strong>Personalized recommendations</strong> - Training, nutrition, and supplement guidance</li>
              <li>✅ <strong>Pricing transparency</strong> - Clear explanation of coaching packages</li>
            </ul>

            <div style="background: var(--light-bg); padding: 2rem; border-radius: 10px; margin-bottom: 2rem;">
              <h4 style="margin-bottom: 1rem;">Choose Your Booking Method:</h4>
              
              <div style="display: flex; flex-direction: column; gap: 1rem;">
                <a href="/contact" class="btn" style="width: 100%; text-align: center; padding: 1rem;">
                  📧 Send Inquiry via Contact Form
                </a>
                
                <div style="text-align: center; color: #999; font-style: italic; margin: 0.5rem 0;">
                  or use the calendar below
                </div>
              </div>
            </div>

            <div style="border: 2px solid var(--light-bg); border-radius: 10px; padding: 1rem; min-height: 500px; background: white;">
              <p style="text-align: center; color: #666; padding: 3rem 2rem;">
                <strong style="display: block; font-size: 1.2rem; margin-bottom: 1rem;">📅 Calendar Booking Coming Soon</strong>
                For now, please use the contact form above to schedule your consultation.
                I'll respond within 24 hours with available time slots.
              </p>
              <!-- Future Calendly embed will go here -->
              <!-- 
              <div class="calendly-inline-widget" 
                   data-url="https://calendly.com/YOUR_USERNAME/free-consultation" 
                   style="min-width:320px;height:630px;">
              </div>
              <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
              -->
            </div>
          </div>

          <div class="card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <h3 style="color: white; margin-bottom: 1.5rem;">Available Sessions:</h3>
            <div style="margin-bottom: 2rem;">
              <h4 style="color: white; opacity: 0.95; margin-bottom: 0.5rem;">📍 In-Person (Long Khanh)</h4>
              <p style="opacity: 0.9; line-height: 1.8;">
                Mon-Fri: 6:00 AM - 9:00 PM<br>
                Sat: 7:00 AM - 8:00 PM<br>
                Sun: 8:00 AM - 6:00 PM
              </p>
            </div>
            <div>
              <h4 style="color: white; opacity: 0.95; margin-bottom: 0.5rem;">💻 Online Coaching</h4>
              <p style="opacity: 0.9; line-height: 1.8;">
                Flexible scheduling available<br>
                Video consultations via Zoom/Google Meet<br>
                Suitable for clients anywhere in Vietnam or abroad
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--light-bg);">
    <div class="container" style="text-align: center;">
      <h2 style="margin-bottom: 2rem;">Not Ready to Book Yet?</h2>
      <div class="grid grid-3">
        <div>
          <h3 style="color: var(--primary); margin-bottom: 0.5rem;">Browse Services</h3>
          <p style="color: #666; margin-bottom: 1rem;">Learn about coaching programs</p>
          <a href="/services" class="btn btn-outline">View Services</a>
        </div>
        <div>
          <h3 style="color: var(--primary); margin-bottom: 0.5rem;">Read FAQ</h3>
          <p style="color: #666; margin-bottom: 1rem;">Get answers to common questions</p>
          <a href="/faq" class="btn btn-outline">View FAQ</a>
        </div>
        <div>
          <h3 style="color: var(--primary); margin-bottom: 0.5rem;">Shop Supplements</h3>
          <p style="color: #666; margin-bottom: 1rem;">Browse premium products</p>
          <a href="/products" class="btn btn-outline">View Products</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .btn-outline {
    background: transparent;
    color: var(--primary);
    border: 2px solid var(--primary);
  }

  .btn-outline:hover {
    background: var(--primary);
    color: white;
  }
</style>
