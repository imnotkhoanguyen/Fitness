---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('vi');
---

<Layout title={`${t('nav.products')} - ${t('site.title')}`}>
  <section class="hero">
    <div class="container">
      <h1>{t('products.title')}</h1>
      <p>Cung cấp năng lượng cho tập luyện với thực phẩm bổ sung cao cấp để có hiệu suất và phục hồi tối đa</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        <div class="card product-card">
          <div class="product-badge best-seller">Bán Chạy</div>
          <h3>{t('products.protein.title')}</h3>
          <p>{t('products.protein.desc')}</p>
          <ul class="feature-list">
            <li>25g+ protein mỗi khẩu phần</li>
            <li>Hấp thụ nhanh</li>
            <li>Nhiều hương vị</li>
            <li>Whey & thực vật</li>
          </ul>
          <button class="btn full-width">Liên Hệ Đặt Hàng</button>
        </div>
        
        <div class="card product-card">
          <div class="product-badge energy">Năng Lượng</div>
          <h3>{t('products.preworkout.title')}</h3>
          <p>{t('products.preworkout.desc')}</p>
          <ul class="feature-list">
            <li>Năng lượng bùng nổ</li>
            <li>Tập trung cao độ</li>
            <li>Kích hoạt pump</li>
            <li>Không gây mệt sau</li>
          </ul>
          <button class="btn full-width">Liên Hệ Đặt Hàng</button>
        </div>

        <div class="card product-card">
          <div class="product-badge recovery">Phục Hồi</div>
          <h3>{t('products.recovery.title')}</h3>
          <p>{t('products.recovery.desc')}</p>
          <ul class="feature-list">
            <li>BCAA tỷ lệ 2:1:1</li>
            <li>L-Glutamine</li>
            <li>Giảm đau nhức</li>
            <li>Sửa chữa cơ nhanh hơn</li>
          </ul>
          <button class="btn full-width">Liên Hệ Đặt Hàng</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section dark-section center-content">
    <div class="container">
      <h2 class="section-title">Tại Sao Chọn Thực Phẩm Bổ Sung Của Chúng Tôi?</h2>
      <div class="grid grid-3">
        <div>
          <h3 class="benefit-title">Đã Kiểm Tra Chất Lượng</h3>
          <p class="benefit-text">Mọi sản phẩm được kiểm tra độ tinh khiết và hiệu lực</p>
        </div>
        <div>
          <h3 class="benefit-title">Huấn Luyện Viên Đề Xuất</h3>
          <p class="benefit-text">Được tôi chọn lọc kỹ cho kết quả tập hybrid</p>
        </div>
        <div>
          <h3 class="benefit-title">Kết Quả Thực</h3>
          <p class="benefit-text">Công thức đã được chứng minh bởi khoa học và kinh nghiệm</p>
        </div>
      </div>
      <a href="/vi/contact" class="btn cta-button">Hỏi Về Sản Phẩm</a>
    </div>
  </section>
</Layout>

<style>
  .dark-section {
    background: #0a0a0a;
  }

  .center-content {
    text-align: center;
  }

  .product-card {
    position: relative;
    border-top: 4px solid #00FFFF;
  }

  .product-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: #00FFFF;
    color: #000000;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
    font-family: 'Montserrat', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .product-badge.energy {
    background: #FF0080;
  }

  .product-badge.recovery {
    background: #00FF88;
  }

  .feature-list {
    margin-top: 1rem;
    color: #cccccc;
    line-height: 2;
    list-style: none;
    padding-left: 0;
  }

  .feature-list li {
    padding-left: 1.5rem;
    position: relative;
  }

  .feature-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #00FFFF;
    font-weight: bold;
  }

  .full-width {
    margin-top: 1.5rem;
    width: 100%;
  }

  .benefit-title {
    color: #00FFFF;
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .benefit-text {
    color: #cccccc;
  }

  .cta-button {
    margin-top: 2rem;
  }
</style>
