---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('vi');
---

<Layout title={`${t('nav.products')} - ${t('site.title')}`}>
  <section class="hero">
    <div class="container">
      <h1>{t('products.title')}</h1>
      <p>Cung cấp năng lượng cho tập luyện với thực phẩm bổ sung cao cấp để có hiệu suất và phục hồi tối đa</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        <div class="card product-card">
          <div class="product-badge">Bán Chạy</div>
          <h3>{t('products.protein.title')}</h3>
          <p>{t('products.protein.desc')}</p>
          <ul style="margin-top: 1rem; color: #666; line-height: 2;">
            <li>25g+ protein mỗi khẩu phần</li>
            <li>Hấp thụ nhanh</li>
            <li>Nhiều hương vị</li>
            <li>Whey & thực vật</li>
          </ul>
          <button class="btn" style="margin-top: 1.5rem; width: 100%;">Liên Hệ Đặt Hàng</button>
        </div>
        
        <div class="card product-card">
          <div class="product-badge">Năng Lượng</div>
          <h3>{t('products.preworkout.title')}</h3>
          <p>{t('products.preworkout.desc')}</p>
          <ul style="margin-top: 1rem; color: #666; line-height: 2;">
            <li>Năng lượng bùng nổ</li>
            <li>Tập trung cao độ</li>
            <li>Kích hoạt pump</li>
            <li>Không gây mệt sau</li>
          </ul>
          <button class="btn" style="margin-top: 1.5rem; width: 100%;">Liên Hệ Đặt Hàng</button>
        </div>

        <div class="card product-card">
          <div class="product-badge">Phục Hồi</div>
          <h3>{t('products.recovery.title')}</h3>
          <p>{t('products.recovery.desc')}</p>
          <ul style="margin-top: 1rem; color: #666; line-height: 2;">
            <li>BCAA tỷ lệ 2:1:1</li>
            <li>L-Glutamine</li>
            <li>Giảm đau nhức</li>
            <li>Sửa chữa cơ nhanh hơn</li>
          </ul>
          <button class="btn" style="margin-top: 1.5rem; width: 100%;">Liên Hệ Đặt Hàng</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--light-bg);">
    <div class="container" style="text-align: center;">
      <h2 style="margin-bottom: 2rem;">Tại Sao Chọn Thực Phẩm Bổ Sung Của Chúng Tôi?</h2>
      <div class="grid grid-3">
        <div>
          <h3 style="color: var(--primary); margin-bottom: 0.5rem;">Đã Kiểm Tra Chất Lượng</h3>
          <p style="color: #666;">Mọi sản phẩm được kiểm tra độ tinh khiết và hiệu lực</p>
        </div>
        <div>
          <h3 style="color: var(--primary); margin-bottom: 0.5rem;">Huấn Luyện Viên Đề Xuất</h3>
          <p style="color: #666;">Được tôi chọn lọc kỹ cho kết quả tập hybrid</p>
        </div>
        <div>
          <h3 style="color: var(--primary); margin-bottom: 0.5rem;">Kết Quả Thực</h3>
          <p style="color: #666;">Công thức đã được chứng minh bởi khoa học và kinh nghiệm</p>
        </div>
      </div>
      <a href="/vi/contact" class="btn" style="margin-top: 2rem;">Hỏi Về Sản Phẩm</a>
    </div>
  </section>
</Layout>

<style>
  .product-card {
    position: relative;
    border-top: 4px solid var(--primary);
  }

  .product-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--primary);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }
</style>
