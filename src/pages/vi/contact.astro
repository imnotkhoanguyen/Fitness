---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('vi');
---

<Layout title={`${t('nav.contact')} - ${t('site.title')}`}>
  <section class="hero">
    <div class="container">
      <h1>{t('contact.title')}</h1>
      <p>{t('contact.coaching.text')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="max-width: 900px; margin: 0 auto;">
        <div class="grid" style="grid-template-columns: 1fr; gap: 2rem;">
          <div class="card">
            <h3 style="margin-bottom: 1.5rem;">{t('contact.coaching')}</h3>
            <form style="display: flex; flex-direction: column; gap: 1.5rem;">
              <div>
                <label for="name" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">{t('contact.name')}</label>
                <input type="text" id="name" name="name" required style="width: 100%; padding: 0.75rem; border: 2px solid #e2e8f0; border-radius: 5px; font-size: 1rem;" />
              </div>
              <div>
                <label for="email" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">{t('contact.email')}</label>
                <input type="email" id="email" name="email" required style="width: 100%; padding: 0.75rem; border: 2px solid #e2e8f0; border-radius: 5px; font-size: 1rem;" />
              </div>
              <div>
                <label for="goal" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Mục Tiêu Thể Hình</label>
                <select id="goal" name="goal" style="width: 100%; padding: 0.75rem; border: 2px solid #e2e8f0; border-radius: 5px; font-size: 1rem;">
                  <option value="">Chọn mục tiêu...</option>
                  <option value="muscle">Tăng Cơ Bắp</option>
                  <option value="strength">Mạnh Hơn</option>
                  <option value="calisthenics">Làm Chủ Calisthenics</option>
                  <option value="weight">Giảm Cân</option>
                  <option value="hybrid">Tập Hybrid</option>
                  <option value="other">Khác</option>
                </select>
              </div>
              <div>
                <label for="experience" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Kinh Nghiệm Tập Luyện</label>
                <select id="experience" name="experience" style="width: 100%; padding: 0.75rem; border: 2px solid #e2e8f0; border-radius: 5px; font-size: 1rem;">
                  <option value="">Chọn trình độ...</option>
                  <option value="beginner">Mới Bắt Đầu (0-1 năm)</option>
                  <option value="intermediate">Trung Cấp (1-3 năm)</option>
                  <option value="advanced">Nâng Cao (3+ năm)</option>
                </select>
              </div>
              <div>
                <label for="message" style="display: block; margin-bottom: 0.5rem; font-weight: 600;">{t('contact.message')}</label>
                <textarea id="message" name="message" rows="5" required style="width: 100%; padding: 0.75rem; border: 2px solid #e2e8f0; border-radius: 5px; font-size: 1rem; resize: vertical;" placeholder="Cho tôi biết về quy trình hiện tại, thách thức và điều bạn muốn đạt được..."></textarea>
              </div>
              <button type="submit" class="btn" style="align-self: flex-start; padding: 1rem 2.5rem;">{t('contact.submit')}</button>
            </form>
          </div>

          <div class="card">
            <h3 style="margin-bottom: 1rem;">Địa Điểm & Giờ Tập</h3>
            <div style="color: #666; line-height: 2;">
              <p><strong>Địa điểm:</strong></p>
              <p>{t('location.address')}</p>
              <p style="margin-top: 1rem;"><strong>Giờ Tập:</strong></p>
              <p>T2-T6: 6:00 SA - 9:00 CH</p>
              <p>T7: 7:00 SA - 8:00 CH</p>
              <p>CN: 8:00 SA - 6:00 CH</p>
              <p style="margin-top: 1rem;"><strong>Dịch Vụ:</strong></p>
              <p>✅ Huấn Luyện 1-1</p>
              <p>✅ Chương Trình Online</p>
              <p>✅ Huấn Luyện Dinh Dưỡng</p>
              <p>✅ Bán Thực Phẩm Bổ Sung</p>
            </div>
          </div>

          <div class="card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <h3 style="margin-bottom: 1rem; color: white;">Câu Hỏi Nhanh?</h3>
            <p style="margin-bottom: 1rem;">Muốn biết về giá, chương trình, hoặc sản phẩm có sẵn?</p>
            <p style="margin-bottom: 1rem;">Điền form bên trên hoặc gửi tin nhắn nhanh với câu hỏi của bạn. Tôi thường phản hồi trong vòng 24 giờ.</p>
            <p style="font-size: 0.9rem; opacity: 0.9;">💪 Tư vấn đầu tiên luôn miễn phí</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
