---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('vi');
---

<Layout title={`${t('nav.contact')} - ${t('site.title')}`}>
  <section class="hero">
    <div class="container">
      <h1>{t('contact.title')}</h1>
      <p>{t('contact.coaching.text')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="content-wrapper">
        <div class="grid contact-grid">
          <div class="card">
            <h3 class="form-title">{t('contact.coaching')}</h3>
            <form class="contact-form">
              <div class="form-group">
                <label for="name" class="form-label">{t('contact.name')}</label>
                <input type="text" id="name" name="name" required class="form-input" />
              </div>
              <div class="form-group">
                <label for="email" class="form-label">{t('contact.email')}</label>
                <input type="email" id="email" name="email" required class="form-input" />
              </div>
              <div class="form-group">
                <label for="goal" class="form-label">Mục Tiêu Thể Hình</label>
                <select id="goal" name="goal" class="form-input">
                  <option value="">Chọn mục tiêu...</option>
                  <option value="muscle">Tăng Cơ Bắp</option>
                  <option value="strength">Mạnh Hơn</option>
                  <option value="calisthenics">Làm Chủ Calisthenics</option>
                  <option value="weight">Giảm Cân</option>
                  <option value="hybrid">Tập Hybrid</option>
                  <option value="other">Khác</option>
                </select>
              </div>
              <div class="form-group">
                <label for="experience" class="form-label">Kinh Nghiệm Tập Luyện</label>
                <select id="experience" name="experience" class="form-input">
                  <option value="">Chọn trình độ...</option>
                  <option value="beginner">Mới Bắt Đầu (0-1 năm)</option>
                  <option value="intermediate">Trung Cấp (1-3 năm)</option>
                  <option value="advanced">Nâng Cao (3+ năm)</option>
                </select>
              </div>
              <div class="form-group">
                <label for="message" class="form-label">{t('contact.message')}</label>
                <textarea id="message" name="message" rows="5" required class="form-input form-textarea" placeholder="Cho tôi biết về quy trình hiện tại, thách thức và điều bạn muốn đạt được..."></textarea>
              </div>
              <button type="submit" class="btn btn-submit">{t('contact.submit')}</button>
            </form>
          </div>

          <div class="card info-card">
            <h3 class="info-title">Địa Điểm & Giờ Tập</h3>
            <div class="info-content">
              <p class="info-label">Địa điểm:</p>
              <p class="info-text">{t('location.address')}</p>
              <p class="info-label">Giờ Tập:</p>
              <p class="info-text">T2-T6: 6:00 SA - 9:00 CH</p>
              <p class="info-text">T7: 7:00 SA - 8:00 CH</p>
              <p class="info-text">CN: 8:00 SA - 6:00 CH</p>
              <p class="info-label">Dịch Vụ:</p>
              <p class="info-text">✅ Huấn Luyện 1-1</p>
              <p class="info-text">✅ Chương Trình Online</p>
              <p class="info-text">✅ Huấn Luyện Dinh Dưỡng</p>
              <p class="info-text">✅ Bán Thực Phẩm Bổ Sung</p>
            </div>
          </div>

          <div class="card cta-card">
            <h3 class="cta-card-title">Câu Hỏi Nhanh?</h3>
            <p class="cta-card-text">Muốn biết về giá, chương trình, hoặc sản phẩm có sẵn?</p>
            <p class="cta-card-text">Điền form bên trên hoặc gửi tin nhắn nhanh với câu hỏi của bạn. Tôi thường phản hồi trong vòng 24 giờ.</p>
            <p class="cta-card-footer">💪 Tư vấn đầu tiên luôn miễn phí</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .content-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .contact-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .form-title {
    margin-bottom: 1.5rem;
    color: #00FFFF;
    font-size: 1.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: #FFFFFF;
    font-family: 'Montserrat', sans-serif;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem;
    border: 2px solid #333333;
    border-radius: 5px;
    font-size: 1rem;
    background: #1a1a1a;
    color: #FFFFFF;
    transition: all 0.3s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: #00FFFF;
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.2);
  }

  .form-textarea {
    resize: vertical;
  }

  .btn-submit {
    align-self: flex-start;
    padding: 1rem 2.5rem;
  }

  .info-card {
    background: #0a0a0a;
    border-left: 4px solid #00FFFF;
  }

  .info-title {
    margin-bottom: 1rem;
    color: #00FFFF;
    font-size: 1.3rem;
  }

  .info-content {
    color: #cccccc;
    line-height: 2;
  }

  .info-label {
    font-weight: 600;
    color: #FFFFFF;
    margin-top: 1rem;
    font-family: 'Montserrat', sans-serif;
  }

  .info-label:first-child {
    margin-top: 0;
  }

  .info-text {
    color: #cccccc;
  }

  .cta-card {
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
    border: 2px solid #00FFFF;
  }

  .cta-card-title {
    margin-bottom: 1rem;
    color: #00FFFF;
    font-size: 1.3rem;
  }

  .cta-card-text {
    margin-bottom: 1rem;
    color: #cccccc;
  }

  .cta-card-footer {
    font-size: 0.9rem;
    color: #00FFFF;
    font-weight: 600;
    margin-top: 1.5rem;
  }
</style>
