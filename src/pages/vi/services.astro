---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('vi');
---

<Layout title={`${t('nav.services')} - ${t('site.title')}`}>
  <section class="hero">
    <div class="container">
      <h1>{t('services.title')}</h1>
      <p>Thay đổi cơ thể với huấn luyện hybrid fitness chuyên nghiệp - calisthenics kết hợp tập tạ</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        <div class="card">
          <h3>{t('services.calisthenics.title')}</h3>
          <p>{t('services.calisthenics.desc')}</p>
          <h4 style="margin-top: 1.5rem; margin-bottom: 0.5rem; color: var(--primary);">Bạn Sẽ Học:</h4>
          <ul style="color: #666; line-height: 2;">
            <li>Kỹ thuật xà đơn hoàn hảo</li>
            <li>Chống đẩy biến thể</li>
            <li>Xà kép & xà đơn nâng cao</li>
            <li>Điều hòa core</li>
            <li>Planche & lever</li>
            <li>Kỹ thuật muscle-up</li>
          </ul>
        </div>
        
        <div class="card">
          <h3>{t('services.weightlifting.title')}</h3>
          <p>{t('services.weightlifting.desc')}</p>
          <h4 style="margin-top: 1.5rem; margin-bottom: 0.5rem; color: var(--primary);">Tập Trung Tập Luyện:</h4>
          <ul style="color: #666; line-height: 2;">
            <li>Squat, deadlift, bench press</li>
            <li>Động tác Olympic</li>
            <li>Phức hợp tạ đơn</li>
            <li>Giao thức tăng cơ</li>
            <li>Chu kỳ sức mạnh</li>
            <li>Bài tập phụ</li>
          </ul>
        </div>

        <div class="card">
          <h3>{t('services.hybrid.title')}</h3>
          <p>{t('services.hybrid.desc')}</p>
          <h4 style="margin-top: 1.5rem; margin-bottom: 0.5rem; color: var(--primary);">Chương Trình Bao Gồm:</h4>
          <ul style="color: #666; line-height: 2;">
            <li>Phân chia tập tùy chỉnh</li>
            <li>Kiểm tra hàng tuần</li>
            <li>Phân tích video kỹ thuật</li>
            <li>Điều chỉnh chương trình</li>
            <li>Thư viện bài tập</li>
            <li>Hỗ trợ nhắn tin 24/7</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--light-bg);">
    <div class="container">
      <h2 class="section-title">{t('services.nutrition.title')}</h2>
      <div style="max-width: 900px; margin: 0 auto;">
        <div class="card">
          <p style="font-size: 1.1rem; margin-bottom: 1.5rem;">
            {t('services.nutrition.desc')}
          </p>
          <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem;">
            <div>
              <h4 style="color: var(--primary); margin-bottom: 0.5rem;">Kế Hoạch Dinh Dưỡng</h4>
              <ul style="color: #666; line-height: 2;">
                <li>Tính toán macro</li>
                <li>Chiến lược thời gian ăn</li>
                <li>Quy trình bổ sung</li>
                <li>Ý tưởng công thức</li>
              </ul>
            </div>
            <div>
              <h4 style="color: var(--primary); margin-bottom: 0.5rem;">Huấn Luyện Lối Sống</h4>
              <ul style="color: #666; line-height: 2;">
                <li>Tối ưu giấc ngủ</li>
                <li>Quản lý căng thẳng</li>
                <li>Xây dựng thói quen</li>
                <li>Trách nhiệm giải trình</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="text-align: center;">
      <h2 class="section-title">Dành Cho Ai?</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3 style="color: var(--primary);">Người Mới Bắt Đầu</h3>
          <p>Mới với thể hình và muốn xây dựng nền tảng vững chắc với kỹ thuật đúng và thói quen bền vững</p>
        </div>
        <div class="card">
          <h3 style="color: var(--primary);">Trung Cấp</h3>
          <p>Có kinh nghiệm tập luyện và sẵn sàng đưa sức mạnh và thể hình lên tầm cao mới</p>
        </div>
        <div class="card">
          <h3 style="color: var(--primary);">Nâng Cao</h3>
          <p>Vận động viên nghiêm túc muốn làm chủ kỹ năng nâng cao và tối ưu hiệu suất với tập hybrid</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--light-bg);">
    <div class="container" style="text-align: center;">
      <h2 style="margin-bottom: 1rem;">Sẵn Sàng Thay Đổi Thể Hình?</h2>
      <p style="margin-bottom: 2rem; font-size: 1.1rem; color: #666;">
        Tham gia cùng các vận động viên tại Long Khánh đang xây dựng sức mạnh nghiêm túc với tập hybrid
      </p>
      <a href="/vi/contact" class="btn" style="font-size: 1.1rem; padding: 1.25rem 2.5rem;">{t('contact.title')}</a>
    </div>
  </section>
</Layout>
