---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('vi');
---

<Layout title={`${t('nav.services')} - ${t('site.title')}`}>
  <section class="hero">
    <div class="container">
      <h1>{t('services.title')}</h1>
      <p>Thay đổi cơ thể với huấn luyện hybrid fitness chuyên nghiệp - calisthenics kết hợp tập tạ</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        <div class="card">
          <h3>{t('services.calisthenics.title')}</h3>
          <p>{t('services.calisthenics.desc')}</p>
          <h4 class="feature-subtitle">Bạn Sẽ Học:</h4>
          <ul class="feature-list">
            <li>Kỹ thuật xà đơn hoàn hảo</li>
            <li>Chống đẩy biến thể</li>
            <li>Xà kép & xà đơn nâng cao</li>
            <li>Điều hòa core</li>
            <li>Planche & lever</li>
            <li>Kỹ thuật muscle-up</li>
          </ul>
        </div>
        
        <div class="card">
          <h3>{t('services.weightlifting.title')}</h3>
          <p>{t('services.weightlifting.desc')}</p>
          <h4 class="feature-subtitle">Tập Trung Tập Luyện:</h4>
          <ul class="feature-list">
            <li>Squat, deadlift, bench press</li>
            <li>Động tác Olympic</li>
            <li>Phức hợp tạ đơn</li>
            <li>Giao thức tăng cơ</li>
            <li>Chu kỳ sức mạnh</li>
            <li>Bài tập phụ</li>
          </ul>
        </div>

        <div class="card">
          <h3>{t('services.hybrid.title')}</h3>
          <p>{t('services.hybrid.desc')}</p>
          <h4 class="feature-subtitle">Chương Trình Bao Gồm:</h4>
          <ul class="feature-list">
            <li>Phân chia tập tùy chỉnh</li>
            <li>Kiểm tra hàng tuần</li>
            <li>Phân tích video kỹ thuật</li>
            <li>Điều chỉnh chương trình</li>
            <li>Thư viện bài tập</li>
            <li>Hỗ trợ nhắn tin 24/7</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section dark-section">
    <div class="container">
      <h2 class="section-title">{t('services.nutrition.title')}</h2>
      <div class="content-wrapper">
        <div class="card">
          <p class="large-text">
            {t('services.nutrition.desc')}
          </p>
          <div class="grid two-col">
            <div>
              <h4 class="feature-subtitle">Kế Hoạch Dinh Dưỡng</h4>
              <ul class="feature-list">
                <li>Tính toán macro</li>
                <li>Chiến lược thời gian ăn</li>
                <li>Quy trình bổ sung</li>
                <li>Ý tưởng công thức</li>
              </ul>
            </div>
            <div>
              <h4 class="feature-subtitle">Huấn Luyện Lối Sống</h4>
              <ul class="feature-list">
                <li>Tối ưu giấc ngủ</li>
                <li>Quản lý căng thẳng</li>
                <li>Xây dựng thói quen</li>
                <li>Trách nhiệm</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section center-content">
    <div class="container">
      <h2 class="section-title">Dành Cho Ai?</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3 class="card-title">Người Mới Bắt Đầu</h3>
          <p>Mới tập và muốn xây dựng nền tảng vững chắc với kỹ thuật đúng và thói quen bền vững</p>
        </div>
        <div class="card">
          <h3 class="card-title">Trung Cấp</h3>
          <p>Đã có kinh nghiệm tập luyện và sẵn sàng đưa sức mạnh và thể hình lên tầm cao mới</p>
        </div>
        <div class="card">
          <h3 class="card-title">Nâng Cao</h3>
          <p>Vận động viên nghiêm túc muốn làm chủ kỹ năng nâng cao và tối ưu hiệu suất với tập hybrid</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section dark-section center-content">
    <div class="container">
      <h2 class="cta-title">Sẵn Sàng Thay Đổi Thể Lực?</h2>
      <p class="cta-subtitle">
        Tham gia các vận động viên tại Long Khánh đang xây dựng sức mạnh nghiêm túc với tập hybrid
      </p>
      <a href="/vi/contact" class="btn btn-large">{t('contact.title')}</a>
    </div>
  </section>
</Layout>

<style>
  .dark-section {
    background: #0a0a0a;
  }

  .center-content {
    text-align: center;
  }

  .content-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .large-text {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }

  .two-col {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .feature-subtitle {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: #00FFFF;
    font-weight: 700;
    font-size: 1.1rem;
  }

  .feature-list {
    color: #cccccc;
    line-height: 2;
    list-style: none;
    padding-left: 0;
  }

  .feature-list li {
    padding-left: 1.5rem;
    position: relative;
  }

  .feature-list li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: #00FFFF;
    font-weight: bold;
  }

  .card-title {
    color: #00FFFF;
    margin-bottom: 1rem;
  }

  .cta-title {
    margin-bottom: 1rem;
    font-size: 2.5rem;
  }

  .cta-subtitle {
    margin-bottom: 2rem;
    font-size: 1.1rem;
    color: #cccccc;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .btn-large {
    font-size: 1.1rem;
    padding: 1.25rem 2.5rem;
  }
</style>
