---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('vi');
---

<Layout title={`${t('nav.about')} - ${t('site.title')}`}>
  <section class="hero">
    <div class="container">
      <h1>{t('about.title')}</h1>
      <p>{t('footer.tagline')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="content-wrapper">
        <div class="card">
          <h2 class="card-title">{t('about.story')}</h2>
          <p class="large-text">
            {t('about.story.text')}
          </p>
          <img src="/images/fitness.png" alt="Tập luyện thể hình" class="feature-image" />
        </div>

        <div class="card">
          <h2 class="card-title">{t('about.mission')}</h2>
          <p class="large-text">
            {t('about.mission.text')}
          </p>
        </div>

        <div class="card">
          <h2 class="card-title">{t('about.expertise')}</h2>
          <p class="large-text">
            {t('about.expertise.text')}
          </p>
          
          <div class="grid expertise-grid">
            <div>
              <h4 class="expertise-title">Chuyên Gia Calisthenics</h4>
              <p class="expertise-text">Chuyên gia làm chủ trọng lượng cơ thể, từ cơ bản đến kỹ năng nâng cao như planche và lever</p>
            </div>
            <div>
              <h4 class="expertise-title">Huấn Luyện Viên Sức Mạnh</h4>
              <p class="expertise-text">Được chứng nhận tập sức mạnh tiến bộ và nền tảng powerlifting</p>
            </div>
            <div>
              <h4 class="expertise-title">Chuyên Gia Dinh Dưỡng</h4>
              <p class="expertise-text">Huấn luyện dinh dưỡng thực tế để tăng cơ, giảm mỡ và hiệu suất</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section dark-section">
    <div class="container">
      <h2 class="section-title">Triết Lý Hybrid Fitness</h2>
      <div class="philosophy-wrapper">
        <div class="grid philosophy-grid">
          <div class="card">
            <h3 class="philosophy-title">Cân Bằng</h3>
            <p>Kết hợp sức mạnh thực chiến của calisthenics với sức mạnh thô của tập tạ để phát triển thể thao toàn diện.</p>
          </div>
          <div class="card">
            <h3 class="philosophy-title">Tiến Bộ</h3>
            <p>Mỗi chương trình được thiết kế với lộ trình tiến bộ rõ ràng, dù bạn đang học xà đơn đầu tiên hay đạt PR mới.</p>
          </div>
          <div class="card">
            <h3 class="philosophy-title">Bền Vững</h3>
            <p>Xây dựng thói quen và quy trình phù hợp với lối sống của bạn - không chế độ ăn cực đoan hay phương pháp tập không bền vững.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section center-content">
    <div class="container">
      <h2 class="cta-title">Tập Với Tôi tại Long Khánh</h2>
      <p class="cta-subtitle">
        Dù bạn mới bắt đầu hành trình thể hình hay đang muốn vượt qua bế tắc,
        tôi sẽ tạo chương trình cá nhân hóa mang lại kết quả thực sự.
      </p>
      <a href="/vi/contact" class="btn btn-large">{t('hero.cta')}</a>
    </div>
  </section>
</Layout>

<style>
  .dark-section {
    background: #0a0a0a;
  }

  .center-content {
    text-align: center;
  }

  .content-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .card {
    margin-bottom: 2rem;
  }

  .card:last-child {
    margin-bottom: 0;
  }

  .card-title {
    color: #00FFFF;
    margin-bottom: 1rem;
    font-size: 2rem;
  }

  .large-text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #cccccc;
    margin-bottom: 1.5rem;
  }

  .feature-image {
    width: 100%;
    border-radius: 10px;
    border: 2px solid #333333;
  }

  .expertise-grid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .expertise-title {
    color: #00FFFF;
    margin-bottom: 0.5rem;
    font-weight: 700;
    font-size: 1.2rem;
  }

  .expertise-text {
    color: #cccccc;
  }

  .philosophy-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .philosophy-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .philosophy-title {
    color: #00FFFF;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .cta-title {
    margin-bottom: 1rem;
    font-size: 2.5rem;
  }

  .cta-subtitle {
    margin-bottom: 2rem;
    font-size: 1.1rem;
    color: #cccccc;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .btn-large {
    font-size: 1.1rem;
    padding: 1.25rem 2.5rem;
  }
</style>
