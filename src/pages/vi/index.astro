---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('vi');
---

<Layout title={`${t('site.title')} - ${t('site.tagline')}`}>
  <section class="hero">
    <div class="container">
      <h1>{t('hero.title')}</h1>
      <p>{t('hero.subtitle')}</p>
      <a href="/vi/contact" class="btn">{t('hero.cta')}</a>
    </div>
  </section>

  <section class="section" style="background: var(--light-bg);">
    <div class="container">
      <h2 class="section-title">{t('services.title')}</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3>{t('services.nutrition.title')}</h3>
          <p>{t('services.nutrition.desc')}</p>
          <a href="/vi/services" class="btn" style="margin-top: 1rem;">{t('services.cta')}</a>
        </div>
        <div class="card">
          <h3>{t('services.fitness.title')}</h3>
          <p>{t('services.fitness.desc')}</p>
          <a href="/vi/services" class="btn" style="margin-top: 1rem;">{t('services.cta')}</a>
        </div>
        <div class="card">
          <h3>{t('services.lifestyle.title')}</h3>
          <p>{t('services.lifestyle.desc')}</p>
          <a href="/vi/services" class="btn" style="margin-top: 1rem;">{t('services.cta')}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="text-align: center;">
      <img src="/images/main-guy.png" alt="Thể dục" style="max-width: 600px; width: 100%; border-radius: 10px; margin-bottom: 2rem;" />
      <h2 style="margin-bottom: 1rem;">Tại Sao Chọn The Energy Factory?</h2>
      <p style="max-width: 800px; margin: 0 auto; font-size: 1.1rem; color: #666;">
        Chúng tôi cung cấp các chương trình huấn luyện cá nhân hóa được thiết kế đặc biệt cho mục tiêu và lối sống của bạn.
        Phương pháp toàn diện của chúng tôi kết hợp dinh dưỡng, thể dục và huấn luyện lối sống để giúp bạn đạt được kết quả lâu dài.
      </p>
    </div>
  </section>
</Layout>
