---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('vi');
---

<Layout title={`${t('site.title')} - ${t('site.tagline')}`}>
  <section class="hero">
    <div class="container">
      <h1>{t('hero.title')}</h1>
      <p>{t('hero.subtitle')}</p>
      <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem; flex-wrap: wrap;">
        <a href="/vi/contact" class="btn">{t('hero.cta')}</a>
        <a href="/vi/products" class="btn btn-outline">{t('hero.cta2')}</a>
      </div>
    </div>
  </section>

  <section class="section dark-section">
    <div class="container">
      <h2 class="section-title">{t('services.title')}</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3>{t('services.calisthenics.title')}</h3>
          <p>{t('services.calisthenics.desc')}</p>
          <ul class="feature-list">
            <li>Xà đơn & xà kép</li>
            <li>Chống đẩy biến thể</li>
            <li>Kỹ năng nâng cao (planche, lever)</li>
            <li>Làm chủ core</li>
          </ul>
          <a href="/vi/services" class="btn">{t('services.cta')}</a>
        </div>
        <div class="card">
          <h3>{t('services.weightlifting.title')}</h3>
          <p>{t('services.weightlifting.desc')}</p>
          <ul class="feature-list">
            <li>Động tác nâng tạ đòn</li>
            <li>Tập với tạ đơn</li>
            <li>Máy tập</li>
            <li>Tăng tải tiến bộ</li>
          </ul>
          <a href="/vi/services" class="btn">{t('services.cta')}</a>
        </div>
        <div class="card">
          <h3>{t('services.hybrid.title')}</h3>
          <p>{t('services.hybrid.desc')}</p>
          <ul class="feature-list">
            <li>Kế hoạch tập tùy chỉnh</li>
            <li>Huấn luyện dinh dưỡng</li>
            <li>Điều chỉnh kỹ thuật</li>
            <li>Theo dõi tiến độ</li>
          </ul>
          <a href="/vi/services" class="btn">{t('services.cta')}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container center-content">
      <img src="/images/main-guy.png" alt="Tập luyện thể hình" class="hero-image" />
      <h2 class="content-title">Tại Sao Tập Hybrid Hiệu Quả</h2>
      <p class="content-description">
        Kết hợp calisthenics với tập tạ mang lại lợi ích của cả hai: sức mạnh thực chiến với trọng lượng cơ thể,
        sức mạnh bùng nổ từ tạ, và thể hình cân đối, vận động viên. Dù bạn 18 hay 45 tuổi, mới bắt đầu hay nâng cao,
        phương pháp đã được chứng minh này xây dựng thể lực thực tế và bền vững.
      </p>
    </div>
  </section>

  <section class="section dark-section">
    <div class="container">
      <h2 class="section-title">Học Viên Nói Gì</h2>
      <div class="grid grid-3">
        <div class="card testimonial">
          <div class="stars">⭐⭐⭐⭐⭐</div>
          <p class="testimonial-text">
            "Tôi từ chỗ khó làm 5 cái xà đơn đến làm được muscle-up trong 4 tháng. Chương trình hybrid đã thay đổi hoàn toàn sức mạnh và thể hình của tôi."
          </p>
          <p class="testimonial-author">- Minh T., 28 tuổi</p>
          <p class="testimonial-location">Long Khánh</p>
        </div>
        <div class="card testimonial">
          <div class="stars">⭐⭐⭐⭐⭐</div>
          <p class="testimonial-text">
            "Đầu tư tốt nhất cho sức khỏe. Huấn luyện dinh dưỡng và bài tập cá nhân hóa giúp tôi giảm 12kg đồng thời tăng cơ. Rất đáng!"
          </p>
          <p class="testimonial-author">- Hương N., 35 tuổi</p>
          <p class="testimonial-location">Đồng Nai</p>
        </div>
        <div class="card testimonial">
          <div class="stars">⭐⭐⭐⭐⭐</div>
          <p class="testimonial-text">
            "Cuối cùng tìm được huấn luyện viên hiểu hybrid training. Kết hợp calisthenics và tạ cho kết quả mà tôi không bao giờ đạt được chỉ tập gym."
          </p>
          <p class="testimonial-author">- Tuấn L., 42 tuổi</p>
          <p class="testimonial-location">TP.HCM</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">{t('products.title')}</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3>{t('products.protein.title')}</h3>
          <p>{t('products.protein.desc')}</p>
          <a href="/vi/products" class="btn">{t('products.cta')}</a>
        </div>
        <div class="card">
          <h3>{t('products.preworkout.title')}</h3>
          <p>{t('products.preworkout.desc')}</p>
          <a href="/vi/products" class="btn">{t('products.cta')}</a>
        </div>
        <div class="card">
          <h3>{t('products.recovery.title')}</h3>
          <p>{t('products.recovery.desc')}</p>
          <a href="/vi/products" class="btn">{t('products.cta')}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .dark-section {
    background: #0a0a0a;
  }

  .center-content {
    text-align: center;
  }

  .hero-image {
    max-width: 600px;
    width: 100%;
    border-radius: 10px;
    margin-bottom: 2rem;
    border: 2px solid #333333;
  }

  .content-title {
    margin-bottom: 1rem;
    font-size: 2.5rem;
    font-weight: 800;
  }

  .content-description {
    max-width: 800px;
    margin: 0 auto;
    font-size: 1.1rem;
    color: #cccccc;
    line-height: 1.8;
  }

  .feature-list {
    margin-top: 1rem;
    color: #cccccc;
    line-height: 2;
    list-style: none;
    padding-left: 0;
  }

  .feature-list li {
    padding-left: 1.5rem;
    position: relative;
  }

  .feature-list li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: #00FFFF;
    font-weight: bold;
  }

  .card .btn {
    margin-top: 1.5rem;
  }

  .testimonial {
    text-align: center;
  }

  .stars {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .testimonial-text {
    font-style: italic;
    color: #cccccc;
    margin: 1rem 0;
    line-height: 1.8;
  }

  .testimonial-author {
    font-weight: 600;
    color: #00FFFF;
    margin-top: 1rem;
  }

  .testimonial-location {
    font-size: 0.9rem;
    color: #888888;
    margin-top: 0.25rem;
  }

  @media (max-width: 768px) {
    .content-title {
      font-size: 2rem;
    }

    .content-description {
      font-size: 1rem;
    }
  }
</style>
